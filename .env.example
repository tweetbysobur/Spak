# Postgres for users, sessions, wallets, SPak-in sessions, intents, submissions and audit log.
# Without it, local development uses an embedded PGlite database in .data/pglite. Production requires it.
DATABASE_URL=
# Public origin of the app, e.g. https://spak.app. Used for sign-in message domain binding, CSRF checks and
# Secure __Host- cookies. If unset, derived from the request (fine for local development).
SPAK_APP_ORIGIN=
# NEAR JSON-RPC used to confirm a NEAR key is a full-access key of the account. Defaults to mainnet.
NEAR_RPC_URL=https://rpc.mainnet.near.org
# Optional. NEAR Intents 1Click API. Defaults to the public endpoint.
ONECLICK_API_URL=https://1click.chaindefuser.com
# Optional. 1Click partner API key (sent as X-API-Key). Server-side only. Without it, quotes carry a 0.2% default fee.
ONECLICK_API_KEY=
# Optional, legacy. 1Click partner JWT, used only when ONECLICK_API_KEY is not set.
ONECLICK_JWT=

# Deposits (Phase 3)
# Largest execution SPak will approve, in USD. Approval fails closed if the USD value is unknown.
SPAK_MAX_EXECUTION_USD=1000
# Optional RPC overrides per source network, comma separated for failover. Example:
# SPAK_RPC_BASE=https://mainnet.base.org,https://base-rpc.publicnode.com
# SPAK_RPC_SOLANA=https://api.mainnet-beta.solana.com
# SPAK_RPC_NEAR=https://rpc.mainnet.near.org
