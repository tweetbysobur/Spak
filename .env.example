# Postgres for users, sessions, wallets, SPak-in sessions, intents, submissions and audit log.
# Without it, local development uses an embedded PGlite database in .data/pglite. Production requires it.
DATABASE_URL=
# Public origin of the app, e.g. https://spak.app. Used for sign-in message domain binding, CSRF checks and
# Secure __Host- cookies. If unset, derived from the request (fine for local development).
SPAK_APP_ORIGIN=
# NEAR JSON-RPC used to confirm a NEAR key is a full-access key of the account. Defaults to mainnet.
NEAR_RPC_URL=https://rpc.mainnet.near.org
# Optional. NEAR Intents 1Click API. Defaults to the public endpoint.
ONECLICK_API_URL=https://1click.chaindefuser.com
# Optional. 1Click partner API key (sent as X-API-Key). Server-side only. Without it, quotes carry a 0.2% default fee.
ONECLICK_API_KEY=
# Optional, legacy. 1Click partner JWT, used only when ONECLICK_API_KEY is not set.
ONECLICK_JWT=

# Deposits (Phase 3)
# Largest execution SPak will approve, in USD. Approval fails closed if the USD value is unknown.
SPAK_MAX_EXECUTION_USD=1000
# Optional RPC overrides per source network, comma separated for failover. Example:
# SPAK_RPC_BASE=https://mainnet.base.org,https://base-rpc.publicnode.com
# SPAK_RPC_SOLANA=https://api.mainnet-beta.solana.com
# SPAK_RPC_NEAR=https://rpc.mainnet.near.org

# Tracking (Phase 4). Bearer tokens for /api/internal/monitor. Use 32+ random characters. Never expose to the browser.
# Vercel sets CRON_SECRET for its cron calls when you add it in the project settings.
CRON_SECRET=
SPAK_MONITOR_SECRET=

# Manual review API (Phase 5). Bearer token for /api/admin/*, 32+ random characters. Server only.
SPAK_ADMIN_TOKEN=

# Phase 5.1: one reviewer per entry, id:sha256-hex-of-token. Never put raw tokens here.
SPAK_REVIEWERS=

# Phase 5.2: refund evidence capability. Keep UNCONFIRMED until docs/REFUND-LIVE-TEST.md proves refund hashes appear in originChainTxHashes.
SPAK_REFUND_EVIDENCE_CAPABILITY=UNCONFIRMED

# --- SPak Agent dedicated accounts (NEAR TESTNET ONLY). See docs/SPAK-TESTNET-SETUP.md ---
# Set these in the server environment only (Vercel project settings or a local untracked .env.local). Never commit them.
# NEAR_RPC_URL above is for owner-identity checks on mainnet; these use their own RPC on purpose.
# SPAK_AGENT_NEAR_NETWORK=testnet
# SPAK_AGENT_NEAR_RPC_URL=https://rpc.testnet.near.org
# SPAK_AGENT_PARENT_ACCOUNT=<your-dedicated-parent>.testnet
# SPAK_AGENT_PARENT_PRIVATE_KEY=<ed25519:... full-access key of the parent; secret>
# SPAK_AGENT_INITIAL_BALANCE=0.1
# SPAK_AGENT_SPONSORSHIP_BUDGET=1
# SPAK_AGENT_MAX_SPONSORED_ACCOUNTS=3
# SPAK_AGENT_BACKGROUND_RECHECK_ENABLED=true
# SPAK_AGENT_RECHECK_INTERVAL_HOURS=24
